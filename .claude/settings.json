{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git merge)",
      "Bash(git merge *)",
      "Bash(git rebase)",
      "Bash(git rebase *)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git branch -D *)",
      "Bash(git branch * -D *)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push *--force*)",
      "Bash(git push *-f)",
      "Bash(git push *-f *)",
      "Bash(git push * +*)",
      "Bash(git push *--delete*)",
      "Bash(git push *-d *)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push *--tags*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(gh api *rulesets* *)",
      "Bash(gh api -* *rulesets*)",
      "Bash(gh api */protection* *)",
      "Bash(gh api -* */protection*)",
      "PowerShell(git merge)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git reset * --hard*)",
      "PowerShell(git branch -D *)",
      "PowerShell(git branch * -D *)",
      "PowerShell(git push)",
      "PowerShell(git push origin)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push *-f)",
      "PowerShell(git push *-f *)",
      "PowerShell(git push * +*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git push *-d *)",
      "PowerShell(git push *--mirror*)",
      "PowerShell(git push *--all*)",
      "PowerShell(git push *--tags*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *:main*)",
      "PowerShell(git push *refs/heads/main*)",
      "PowerShell(gh api *rulesets* *)",
      "PowerShell(gh api -* *rulesets*)",
      "PowerShell(gh api */protection* *)",
      "PowerShell(gh api -* */protection*)"
    ],
    "ask": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(aws *ecs update-service*)",
      "Bash(aws *ecs register-task-definition*)",
      "Bash(aws *s3 sync*)",
      "Bash(aws *s3 cp*)",
      "Bash(aws *s3 rm*)",
      "Bash(aws *cloudfront create-invalidation*)",
      "Bash(aws *amplify start-job*)",
      "Bash(docker push *)",
      "PowerShell(gh pr merge)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh api *pulls/*/merge*)",
      "PowerShell(aws *ecs update-service*)",
      "PowerShell(aws *ecs register-task-definition*)",
      "PowerShell(aws *s3 sync*)",
      "PowerShell(aws *s3 cp*)",
      "PowerShell(aws *s3 rm*)",
      "PowerShell(aws *cloudfront create-invalidation*)",
      "PowerShell(aws *amplify start-job*)",
      "PowerShell(docker push *)"
    ],
    "allow": [
      "Bash(gh pr create *)",
      "PowerShell(gh pr create *)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
